# ── LLM 提供商（必填）─────────────────────────────────────────────
# 可选: deepseek (本地开发) | coze (Coze 平台)
LLM_PROVIDER=deepseek

# ── DeepSeek API（AI 解读，LLM_PROVIDER=deepseek 时必填）──────────
# 从 https://platform.deepseek.com/api_keys 注册并获取
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# ── Coze PAT（LLM_PROVIDER=coze 时必填）───────────────────────────
# 从 https://www.coze.cn 或 https://www.coze.com 获取 Personal Access Token
COZE_API_TOKEN=pat_your_token_here
COZE_BOT_ID=your_bot_id_here

# ── Coze Agent Stream API（新闻真伪鉴定等，可选）──────────────────
COZE_API_URL=https://xks6nwtnyr.coze.site/stream_run
COZE_BEARER_TOKEN=your_coze_bearer_token_here
COZE_PROJECT_ID=7643022710771204136
COZE_SESSION_ID=your_coze_session_id_here

# ── 阿里云通义千问 Qwen-VL（截图识别股票代码，可选）──────────────
# 未设置则回退 easyocr 本地 OCR
# 从 https://dashscope.console.aliyun.com/apiKey 获取
DASHSCOPE_API_KEY=sk-your_dashscope_key_here
